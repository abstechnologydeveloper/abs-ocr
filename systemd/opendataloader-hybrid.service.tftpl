[Unit]
Description=OpenDataLoader Hybrid OCR Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${ssh_user}
WorkingDirectory=/opt/abs-ocr/service
Environment="PATH=/opt/abs-ocr/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/opt/abs-ocr/venv/bin/abs-ocr-server ${service_args}
Restart=always
RestartSec=5
TimeoutStartSec=180
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
